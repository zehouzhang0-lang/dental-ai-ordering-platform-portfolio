# Local development only. Copy this file to .env and replace every local-only
# value before using the application outside an isolated workstation.
LOCAL_BIND_ADDRESS=127.0.0.1
SERVER_PORT=8080
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

MYSQL_DATABASE=ai_order_platform
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ai_order
MYSQL_PASSWORD=local-only-change-me
MYSQL_ROOT_PASSWORD=local-only-change-me-root

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=local-only-change-me-minio
MINIO_INTERNAL_ENDPOINT=http://127.0.0.1:9000
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=ai-order-private
FILE_ALLOWED_FILENAME_EXTENSIONS=stl,sla,ply,obj,pdf,jpg,jpeg,png,webp,dcm,dicom,zip,doc,docx,txt

APP_INSTANCE_ID=local-ai-order-portfolio
APP_AUTH_TOKEN_SECRET=local-only-change-me-auth-secret
APP_AUTH_TOKEN_TTL_SECONDS=7200
APP_AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
APP_AUTH_ALLOW_BOOTSTRAP_HEADERS=true
APP_AUTH_ALLOW_ROLE_FALLBACK=true

# The review build is deterministic by default and needs no external AI key.
AI_PROVIDER=deterministic
AI_DEEPSEEK_ENABLED=false
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
AI_EXTERNAL_ALERT_WEBHOOK_ENABLED=false
AI_EXTERNAL_ALERT_WEBHOOK_URL=
AI_EXTERNAL_ALERT_WEBHOOK_SIGNING_SECRET=

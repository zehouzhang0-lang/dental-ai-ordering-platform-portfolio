<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.yuri.aiorder</groupId>
        <artifactId>ai-order-platform-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>ruoyi-runtime-bridge</artifactId>
    <packaging>jar</packaging>

    <name>RuoYi Runtime Bridge</name>
    <description>Incremental runtime bridge to the pinned RuoYi-Vue-Pro core source.</description>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>add-pinned-ruoyi-common-source</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.basedir}/../../vendor/ruoyi-vue-pro-core/yudao-framework/yudao-common/src/main/java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>com/yuri/aiorder/ruoyi/**/*.java</include>
                        <include>cn/iocoder/yudao/framework/common/enums/WebFilterOrderEnum.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
